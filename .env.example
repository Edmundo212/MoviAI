# Copia este archivo como .env y completa tus datos (NO subas .env a GitHub)
VISION_ENDPOINT=https://<tu-recurso>.cognitiveservices.azure.com/
VISION_KEY=<tu-clave>
# Plan F0 de Azure: ~20 llamadas/min -> 3.1 s entre llamadas
VISION_MIN_SECONDS_BETWEEN_CALLS=3.1
MIN_CONFIDENCE=0.5
FRAME_INTERVAL_SECONDS=3
MAX_FRAMES=40
# MongoDB (opcional). Si se deja vacío se guarda en data/analyses.json
MONGODB_URI=
MONGODB_DB=smartflow
MONGODB_COLLECTION=smartflow_analyses

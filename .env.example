# Copia este archivo como .env y completa tus datos (NO subas .env a GitHub)
VISION_ENDPOINT=https://<tu-recurso>.cognitiveservices.azure.com/
VISION_KEY=<tu-clave>
# Plan F0 de Azure: ~20 llamadas/min -> 3.1 s entre llamadas
VISION_MIN_SECONDS_BETWEEN_CALLS=3.1
MIN_CONFIDENCE=0.5
FRAME_INTERVAL_SECONDS=3
MAX_FRAMES=40
# MongoDB (opcional). Si se deja vacío se guarda en data/analyses.json
MONGODB_URI=
MONGODB_DB=smartflow
MONGODB_COLLECTION=smartflow_analyses
MONGODB_MEASUREMENTS_COLLECTION=smartflow_measurements
# Video en vivo: fotogramas por segundo del stream y ancho en píxeles
LIVE_FPS=15
LIVE_STREAM_WIDTH=960
# Detector local YOLOX (models/yolox_s.onnx) que complementa a Azure. 0 = solo Azure
LOCAL_DETECTOR=1
LOCAL_MIN_CONFIDENCE=0.3
LOCAL_TILES=1
LIVE_LOCAL_REFRESH_SECONDS=1.0
